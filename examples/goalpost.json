{
  "enabled": true,
  "specFirst": true,
  "freezeSpec": true,
  "requireAudit": true,
  "auditAgent": "goalpost:auditor",
  "auditMinCriteria": 0,
  "maxNoProgressBlocks": 3,
  "maxBlocks": 80,
  "maxMinutes": 0,
  "progressEveryEdits": 15,
  "reminderEveryToolCalls": 25,
  "sameErrorThreshold": 3,
  "protectExistingTests": true,
  "testGlobs": [
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/spec/**",
    "**/specs/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_test.*",
    "**/test_*.py",
    "**/conftest.py",
    "**/*Test.java",
    "**/*Tests.java",
    "**/*Test.kt",
    "**/*Tests.cs",
    "**/*_spec.rb"
  ],
  "protectedPaths": [],
  "ignoreDirs": [
    "node_modules",
    ".git",
    ".goal",
    "dist",
    "build",
    "out",
    "target",
    "vendor",
    ".venv",
    "venv",
    "__pycache__",
    ".next",
    ".nuxt",
    "coverage",
    ".cache",
    ".tox",
    ".mypy_cache",
    ".pytest_cache",
    ".claude"
  ],
  "scanLimit": 20000,
  "verifyTimeoutSec": 900,
  "verifyShell": "auto"
}
